<style>
#candidatures_nom,#candidatures_prenom,#candidatures_datenaissance,#candidatures_ville,#candidatures_email,#candidatures_tel,#candidatures_poste,#candidatures_experience,#candidatures_lettre{
display:none;
}
</style>

{{ form_start(form) }}
 <div class="form-row">
	<div class="col-md-3">

		{{ form_row(form.nom,{'attr': {'class': 'form-control'}}) }}
		{{ form_errors(form.nom) }}
    <b>{{ 'form-candidature-nom'|trans }} :</b> {{candidature.nom}}
	</div>

	<div class="col-md-3">
	
		{{ form_row(form.prenom,{'attr': {'class': 'form-control custom-datepicker'}}) }}
		{{ form_errors(form.prenom) }}
    <b>{{ 'form-candidature-prenom'|trans }} :</b> {{candidature.prenom}}
	</div>
  	<div class="col-md-3">
		  
		{{ form_row(form.datenaissance,{'attr': {'class': 'form-control custom-datepicker'}}) }}
		{{ form_errors(form.datenaissance) }}
    <b>{{ 'form-candidature-date'|trans }} :</b> {{candidature.datenaissance|date('Y-m-d')}}
	</div>
    	<div class="col-md-3">
		   
		{{ form_row(form.ville,{'attr': {'class': 'form-control custom-datepicker'}}) }}
		{{ form_errors(form.ville) }}
   <b>{{ 'form-candidature-ville'|trans }} :</b> {{candidature.ville}}
	</div>
</div>
<br>
 <div class="form-row">
	<div class="col-md-3">
   
	   {{ form_row(form.email,{'attr': {'class': 'form-control'}}) }}

		{{ form_errors(form.email) }}
   <b>{{ 'form-candidature-email'|trans }} :</b> {{candidature.email}}
	</div>
  <div class="col-md-3">
  
	   {{ form_row(form.tel,{'attr': {'class': 'form-control'}}) }}

		{{ form_errors(form.tel) }}
    <b>{{ 'form-candidature-telephone'|trans }} :</b> {{candidature.tel}}
	</div>
    <div class="col-md-3">
   
	   {{ form_row(form.experience,{'attr': {'class': 'form-control'}}) }}

		{{ form_errors(form.experience) }}
    <b>{{ 'candidats.experience'|trans }} :</b><br> {{candidature.experience}}
	</div>
  <div class="col-md-3">

	   {{ form_row(form.poste,{'attr': {'class': 'form-control'}}) }}

		{{ form_errors(form.poste) }}
    <b>{{ 'candidats.poste'|trans }} :</b><br> {{candidature.poste}}
	</div>
 </div>
 <br>
  <div class="form-row">
    	<div class="col-md-10">
     
		{{ form_row(form.lettre,{'attr': {'class': 'form-control'}}) }}
		{{ form_errors(form.lettre) }}
    <b>{{ 'form-candidature-lettre'|trans }} :</b><br> {{candidature.lettre|raw}}
	    </div>
        	<div class="col-md-3">
           <br>
          	{% if candidature.cv %}
          <a  href="{{ asset('uploads/' ~ candidature.cv) }}" target="_blank"> <span class="mb-2 me-2 btn-icon btn btn-alternate"><i class="pe-7s-cloud-download"> </i> Download CV</span></a> 
		      {% endif %}
    <div style="display:none;">
     
          {{ form_row(form.cv,{'attr': {'class': 'form-control '}}) }}
          {{ form_errors(form.cv) }}
          </div>
	    </div>
    </div>     
    <br>    <br>

{{ form_end(form) }}
