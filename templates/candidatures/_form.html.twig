<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.5/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-SgOJa3DmI69IUzQ2PVdRZhwQ+dy64/BUtbMJw1MZ8t5HZApcHrRKUc4W0kG879m7" crossorigin="anonymous">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.5/dist/js/bootstrap.bundle.min.js" integrity="sha384-k6d4wzSIapyDyv1kpU366/PK5hCdSbCRGRCMv+eplOQJWyd1fbcAu9OCUj5zNLiq" crossorigin="anonymous"></script>
<style>
.modal{
    --bs-modal-width: 800px;
}
.content-block {
    padding-top: 0;
    padding-bottom: 0;
}
input[type=file] {
    position: relative !important;
    height: auto;
    width: auto; 
    overflow: hidden;
    clip: rect(1px 1px 1px 1px);
    clip: rect(1px, 1px, 1px, 1px);
    white-space: nowrap;
}
.required{
        color: #1a2955;
        font-weight:500;
}

</style>
<div class="modal modal-sheet position-static d-block bg-body-secondary p-4 py-md-5" tabindex="-1" role="dialog" id="modalSignin">
  <div class="modal-dialog">
    <div class="modal-content rounded-4 shadow">
      <div class="modal-header p-5 pb-4 border-bottom-0">
        <h1 class="fw-bold mb-0 fs-2" style="color: #1a2955;">Soumettre votre candidature </h1>
   
      </div>

 

      <div class="modal-body p-5 pt-0">
         {{ form_errors(form) }}
         {{ form_start(form) }}
  <div class="row">
        <div class="form-floating col-md-6">
        <span for="candidatures_experience" class="required">Postes disponnibles <b style="color:red;">*</b></span>
          {{ form_row(form.poste,{'attr': {'class': 'form-control rounded-3'}}) }}
        </div>
        
        <div class="form-floating col-md-6">
        <span for="candidatures_experience" class="required">Votre expérience <b style="color:red;">*</b></span>
          {{ form_row(form.experience,{'attr': {'class': 'form-control rounded-3','placeholder': 'Votre Expérience'}}) }}
         <br> 
        </div>
       
  </div>


  <div class="row">
  
        <div class="form-floating col-md-6">
        <span for="candidatures_experience" class="required">Nom <b style="color:red;">*</b></span>
          {{ form_row(form.nom,{'attr': {'class': 'form-control rounded-3','placeholder': 'Votre nom'}}) }}
        </div>

        <div class="form-floating col-md-6">
        <span for="candidatures_experience" class="required">Prenom <b style="color:red;">*</b></span>
          {{ form_row(form.prenom,{'attr': {'class': 'form-control rounded-3','placeholder': 'Votre prenom'}}) }}
        </div>
        <br> <br>
  </div>
  

   <div class="row">
        <div class="form-floating col-md-6">
        <br>
        <span for="candidatures_experience" class="required">Date de naissance <b style="color:red;">*</b></span>
          {{ form_row(form.datenaissance,{'attr': {'class': 'form-control rounded-3','placeholder': 'Votre date de naissance'}}) }}
        </div>

        <div class="form-floating col-md-6">
        <br>
        <span for="candidatures_experience" class="required">Ville <b style="color:red;">*</b></span>
          {{ form_row(form.ville,{'attr': {'class': 'form-control rounded-3','placeholder': 'name@example.com'}}) }}
         <br> 
        </div>
  </div>
    <div class="row">
        <div class="form-floating col-md-6">
        <span for="candidatures_experience" class="required">Téléphone <b style="color:red;">*</b></span>
          {{ form_row(form.tel,{'attr': {'class': 'form-control rounded-3','placeholder': 'Téléphone'}}) }}
        </div>

        <div class="form-floating col-md-6">
        <span for="candidatures_experience" class="required">Email <b style="color:red;">*</b></span>
          {{ form_row(form.email,{'attr': {'class': 'form-control rounded-3','placeholder': 'name@example.com'}}) }}
         <br> 
        </div>
  </div>

     <div class="row">
        <div class="form-floating col-md-12">
        <span for="candidatures_experience" class="required">Lettre de motivation </span>
          {{ form_row(form.lettre,{'attr': {'class': 'form-control rounded-3','placeholder': 'Votre message'}}) }}
        </div>
        <br> <br>

  
  </div>

       <div class="row">
        <div class="form-floating col-md-12">
         <br>
        <span for="candidatures_experience" class="required">Votre CV <b style="color:red;">*</b></span>
          {{ form_row(form.cv,{'attr': {'class': 'form-control'}}) }}
          <br>
        </div>

  
  </div>


          <div class="form-floating mb-3">
           
            
            
          </div>
          <button class="w-100 mb-2 btn btn-lg rounded-3 btn-primary" type="submit">Envoyer</button>
         
          
         
         {{ form_end(form) }}
      </div>
    </div>
  </div>
</div>






