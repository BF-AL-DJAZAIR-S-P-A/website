{% extends 'base.html.twig' %}

{% block title %}Candidatures{% endblock %}

{% block body %}
    <h1>Candidatures</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ candidature.id }}</td>
            </tr>
            <tr>
                <th>Nom</th>
                <td>{{ candidature.nom }}</td>
            </tr>
            <tr>
                <th>Prenom</th>
                <td>{{ candidature.prenom }}</td>
            </tr>
            <tr>
                <th>Datenaissance</th>
                <td>{{ candidature.datenaissance ? candidature.datenaissance|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>Lettre</th>
                <td>{{ candidature.lettre }}</td>
            </tr>
            <tr>
                <th>Cv</th>
                <td>{{ candidature.cv }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_candidatures_index') }}">back to list</a>

    <a href="{{ path('app_candidatures_edit', {'id': candidature.id}) }}">edit</a>

    {{ include('candidatures/_delete_form.html.twig') }}
{% endblock %}
