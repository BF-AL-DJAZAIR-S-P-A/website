{% extends 'dashboard.html.twig' %}

{% block title %}Candidats{% endblock %}

{% block body %}
<style>
		form {
			display: contents;
		}
		.select2{
			width: 100% !important;
	

    font-size: 1rem;
    font-weight: 400;
    line-height: 1.5;
    color: #495057;
    background-color: #fff;
    background-clip: padding-box;

    border-radius: 0.25rem;
		}
		.page,.current,.previous,.first,.next,.last{
    border: solid 1px;
    padding: 5px;
    margin: 2px;
}

	</style>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet">

	{{ block("MenuTop", "Menus/MenuTop.html.twig") }}
    	<div class="app-main">
		{{ block("MenuLeft", "Menus/MenuLeft.html.twig") }}


		<div class="app-main__outer">
			<div class="app-main__inner">
				<div class="app-page-title">
					<div class="page-title-wrapper">
						<div class="page-title-heading">
							<div class="page-title-icon">
								<i class="fa fa-users icon-gradient bg-ripe-malin" style="margin: -2px;"></i>
                                
							</div>
							<div>{{ 'pagesAdmin.candidats-titre'|trans }}
								<div class="page-title-subheading">{{ 'pagesAdmin.candidats-soustitre'|trans }}</div>
							</div>
						</div>
						<div class="page-title-actions">

						
						</div>
					</div>
				</div>

				<div class="tabs-animation">
					<div class="main-card mb-3 card">
						<div class="card-body">
						

							<div id="example_wrapper" class="dataTables_wrapper dt-bootstrap4">

								<div class="row">
									<div class="col-sm-12">
							<table style="width: 100%;" id="maTable" class="table table-hover table-striped table-bordered dataTable dtr-inline" role="grid" aria-describedby="example_info">

        <thead>
            <tr>
                <th>{{ 'candidats.poste'|trans }}</th>
                <th>{{ 'candidats.experience'|trans }}</th>
                <th>{{ 'candidats.nom'|trans }} & {{ 'candidats.prenom'|trans }}</th>
              
                <th>{{ 'candidats.datenaissance'|trans }}</th>
				<th>{{ 'candidats.ville'|trans }}</th>
				<th>{{ 'candidats.telephone'|trans }}</th>
                
				<th>Note</th>
				<th>Statut</th>
				<th>Mail</th>
				<th>Action</th>
				
               
            </tr>
        </thead>
        <tbody>
        {% for candidature in candidatures %}
            <tr>
                <td>{{ candidature.poste }}</td>
                <td>{{ candidature.experience }}</td>
                <td>{{ candidature.nom }} {{ candidature.prenom }}</td>
				<td>{{ candidature.tel }}</td>
             
                
				<td>
				{% if candidature.note is not null %}
					{% for i in 1..5 %}
						{% if i <= candidature.note.valeur %}
							<i class="fas fa-star text-warning"></i> {# étoile pleine #}
						{% else %}
							<i class="far fa-star text-muted"></i> {# étoile vide #}
						{% endif %}
					{% endfor %}
				{% else %}
					<span class="text-muted">Pas encore noté</span>
				{% endif %}
				</td>

				<td>
				{% if candidature.statut is not null %}
                {% if candidature.statut.libelle == 'non_traité' %}
                    <span class="badge bg-secondary">Non traité</span>
                {% elseif candidature.statut.libelle == 'admis' %}
                    <span class="badge bg-success">Admis</span>
                {% elseif candidature.statut.libelle == 'refusé' %}
                    <span class="badge bg-danger">Refusé</span>
                {% else %}
                    <span class="badge bg-dark">{{ candidature.statut.libelle }}</span>
                {% endif %}
            {% else %}
                <span class="text-muted">Pas encore défini</span>
            {% endif %}
				</td>
				<td>
					{% if candidature.mails|length > 0 %}
						{% set envoyes = 0 %}
						{% set erreurs = 0 %}
						{% for mail in candidature.mails %}
							{% if mail.statutEnvoi starts with 'envoyé' %}
								{% set envoyes = envoyes + 1 %}
							{% elseif mail.statutEnvoi starts with 'erreur' %}
								{% set erreurs = erreurs + 1 %}
							{% endif %}
						{% endfor %}

						<span class="badge bg-success">{{ envoyes }} mail envoyé(s)</span>
						
					{% else %}
						<span class="badge bg-secondary">Aucun mail envoyé</span>
					
					{% endif %}
				</td>
				<td class="sorting_1 dtr-control">

										<a href="{{ path('app_candidatures_edit', {'id': candidature.id}) }}">
											<button class="mb-2 mr-2 btn-icon btn-pill btn btn-link">
												<i class="pe-7s-tools btn-icon-wrapper"></i>Edit</button>
										</a>
									</td>
            </tr>
        {% else %}
            <tr>
                <td colspan="7">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
										
							
									</div>
								</div>


							</div>
						</div>
					</div>


				</div>

			</div>

		</div>
	</div>

		{{ block("Footer", "Menus/Footer.html.twig") }}
	<script src="https://code.jquery.com/jquery-2.2.4.min.js" integrity="sha256-BbhdlvQf/xTY9gja0Dq3HiwQF8LaCRTXxZKRutelT44=" crossorigin="anonymous"></script>

	<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet"/>

	<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

	<script>

		$(document).ready(function () {

$("#filtre_bloc_classe").select2({
    placeholder: "Filtrer par classe",
    allowClear: true
});
});
	</script>


{% endblock %}





