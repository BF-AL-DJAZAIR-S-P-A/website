{% if candidature.note is not null and candidature.note.valeur is not null %}
    {# afficher le formulaire statut #}
    {{ form_start(formStatut) }}
    <div class="form-row">
        <div class="col-md-3">
            {{ form_row(formStatut.libelle, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(formStatut.libelle) }}
        </div>
    </div>
    <br>
    <button type="submit" class="mt-1 btn btn-success">
        {{ button_label|default('Sauvegarder') }}
    </button>
    {{ form_end(formStatut) }}
{% else %}
    <div class="alert alert-warning mt-2">
        ⚠️ Vous devez d’abord noter le candidat avant de définir son statut.
    </div>
{% endif %}