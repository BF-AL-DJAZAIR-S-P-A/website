<style>
.star-ratingg {
  direction: rtl; /* pour que les étoiles se remplissent de gauche à droite */
  display: inline-flex;
}

.star-ratingg input {
  display: none;
}

.star-ratingg label {
  font-size: 2rem;
  color: #ccc;
  cursor: pointer;
}

.star-ratingg input:checked ~ label {
  color: gold;
}

.star-ratingg label:hover,
.star-ratingg label:hover ~ label {
  color: gold;
}
</style>
{{ form_start(formNote) }}

<div class="star-ratingg">
    {% for i in 1..5 %}
        <input type="radio" id="star{{ i }}" name="{{ formNote.valeur.vars.full_name }}" value="{{ i }}"
            {% if formNote.valeur.vars.value == i %}checked{% endif %}>
        <label for="star{{ i }}">★</label>
    {% endfor %}
</div>

<button class="btn">{{ button_label|default('Save') }}</button>

{{ form_end(formNote, {'render_rest': false}) }}