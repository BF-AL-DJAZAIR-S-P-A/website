<style>
.star-rating {
    appearance: none;
    -webkit-appearance: none;
    -moz-appearance: none;
    background: transparent !important;
    border: none;
    font-size: 0; /* cache le texte (⭐⭐⭐) */
    width: 0;
    height: 0;
    position: absolute;
    left: -9999px; /* décalé hors écran */
}

/* Utiliser ton composant d’étoiles custom */
.star-rating-widget {
    display: flex;
    gap: 5px;
    cursor: pointer;
}
.star-rating-widget .star {
    font-size: 30px;
    color: gray;
}
.star-rating-widget .star.selected,
.star-rating-widget .star:hover,
.star-rating-widget .star:hover ~ .star {
    color: gold;
}

</style>
{{ form_start(formNote) }}

<div class="star-rating">
    {% for i in 5..1 %}
        <input type="radio" id="star{{ i }}" name="note[valeur]" value="{{ i }}" 
               {% if formNote.valeur.vars.value == i %}checked{% endif %}>
        <label for="star{{ i }}">★</label>
    {% endfor %}
</div>

<button class="btn">{{ button_label|default('Save') }}</button>

{{ form_end(formNote, {'render_rest': false}) }}