<style>
.star-rating {
    direction: rtl; /* étoiles de droite à gauche */
    display: inline-flex;
}

.star-rating input[type="radio"] {
    display: none;
}

.star-rating label {
    font-size: 2rem;
    color: #ddd;
    cursor: pointer;
}

.star-rating input[type="radio"]:checked ~ label {
    color: gold;
}
</style>

{{ form_start(formNote) }}

<div class="star-rating">
    {% for i in range(1, 5)|reverse %}
        <input type="radio" id="star{{ i }}" name="note[valeur]" value="{{ i }}" 
               {% if formNote.valeur.vars.value == i %}checked{% endif %}>
        <label for="star{{ i }}">★</label>
    {% endfor %}
</div>

<button class="btn">{{ button_label|default('Save') }}</button>

{{ form_end(formNote, {'render_rest': false}) }}