<style>
.custom-star-rating {
  display: inline-flex;
  flex-direction: row-reverse; /* ordre visuel 5 → 1 */
  gap: .25rem;
}
.custom-star-rating input[type="radio"] { display: none; }
.custom-star-rating label {
  font-size: 2rem;
  color: #ddd;
  cursor: pointer;
  transition: color .15s ease-in-out;
}
/* colorer l’étoile cochée + toutes celles à gauche (visuellement) */
.custom-star-rating input[type="radio"]:checked ~ label { color: gold; }
/* effet hover */
.custom-star-rating label:hover,
.custom-star-rating label:hover ~ label { color: gold; }
</style>

{{ form_start(formNote) }}
  {# important si tu utilises render_rest: false #}
  {{ form_row(formNote._token) }}

  {% set current = formNote.valeur.vars.value ?? 0 %}

  <div class="custom-star-rating">
    {% for i in range(1, 5)|reverse %}
      <input
        type="radio"
        id="star{{ i }}"
        name="{{ formNote.valeur.vars.full_name }}"
        value="{{ i }}"
        {% if current == i %}checked{% endif %}
      >
      <label for="star{{ i }}">★</label>
    {% endfor %}
  </div>

  <button class="btn">{{ button_label|default('Update') }}</button>
{{ form_end(formNote, {'render_rest': false}) }}