{% block MenuTop %}
	<div class="app-header header-shadow">
		<div class="app-header__logo">
			<img src="{{asset('assets/images/originals/2.svg')}}" width="200">
			<div class="header__pane ml-auto">
				<div>
					<button type="button" class="hamburger close-sidebar-btn hamburger--elastic" data-class="closed-sidebar">
						<span class="hamburger-box">
							<span class="hamburger-inner"></span>
						</span>
					</button>
				</div>
			</div>
		</div>
		<div class="app-header__mobile-menu">
			<div>
				<button type="button" class="hamburger hamburger--elastic mobile-toggle-nav">
					<span class="hamburger-box">
						<span class="hamburger-inner"></span>
					</span>
				</button>
			</div>
		</div>
		<div class="app-header__menu">
			<span>
				<button type="button" class="btn-icon btn-icon-only btn btn-primary btn-sm mobile-toggle-header-nav">
					<span class="btn-icon-wrapper">
						<i class="fa fa-ellipsis-v fa-w-6"></i>
					</span>
				</button>
			</span>
		</div>
		<div class="app-header__content">

			<div class="app-header-right">
				<div class="header-dots">
				<div class="lang" style="padding-right: 5px;margin-top: 5px;">Language : </div>
				{% set locales = ['fr', 'en', 'ar', 'it'] %}
				{% set currentLocale = app.request.locale %}
				{% set homepageRoute = 'app_candidatures_index' %}
					 <div class="language-menu" id="languageMenu">
						<div class="language-selected"> {{ locale|upper }}</div>
					 {% for locale in locales %}
                            {% if locale != currentLocale %}
                                <a href="{{ path(homepageRoute, {'_locale': locale}) }}">
                                  <div data-lang="{{ locale }}">  {{ locale|upper }}</div>
                                </a>
                            {% endif %}
                        {% endfor %}
					 
					</div>
				</div>
					
				</div>
				<div class="header-btn-lg pr-0">
					<div class="widget-content p-0">
						<div class="widget-content-wrapper">
							<div class="widget-content-left">
								<div class="btn-group">
									<a data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" class="p-0 btn">
										
																<img width="42" class="rounded-circle" src="{{asset('assets/images/avatars/user01.png')}}" alt="">
																
									
										<i class="fa fa-angle-down ml-2 opacity-8"></i>
									</a>
									<div tabindex="-1" role="menu" aria-hidden="true" class="rm-pointers dropdown-menu-lg dropdown-menu dropdown-menu-right">
										<div class="dropdown-menu-header">
											<div class="dropdown-menu-header-inner bg-focus">
												<div class="menu-header-image opacity-2" style="background-image: url('{{asset('assets/images/dropdown-header/city3.jpg')}}');"></div>
												<div class="menu-header-content text-left">
													<div class="widget-content p-0">
														<div class="widget-content-wrapper">
															<div class="widget-content-left mr-3">
														
														
																<img width="42" class="rounded-circle" src="{{asset('assets/images/avatars/user01.png')}}" alt="">
																
															</div>
															<div class="widget-content-left" style="color:white;">
							

																{% if is_granted('ROLE_ADMIN') %}

																	{% if app.user.roles[0] == "ROLE_ADMIN" %}
																		<div class="widget-heading">{{app.user.email}}</div>
																		<div class="widget-subheading">
																			Administrateur
																		</div>
																	{% endif %}

																{% endif %}

																
															
															</div>

														</div>
													</div>
												</div>
											</div>
										</div>
										<div class="scroll-area-xs" style="height: 150px;">
											<div class="scrollbar-container ps">
												<ul class="nav flex-column">
												
													<li class="nav-item"> 
														<a href="" class="nav-link">Modifier mon profil</a>
													</li>

													<li class="nav-item">
														<a href="javascript:void(0);" class="nav-link">Changer mon mot de passe</a>
													</li>

													<li class="nav-item">
														<a href="{{path('app_logout')}}" class="nav-link">Se déconnecter</a>
													</li>


												</ul>
											</div>
										</div>

									</div>
								</div>
							</div>
							<div class="widget-content-left  ml-3 header-user-info" style="color:black !important;">
								{% if is_granted('ROLE_ETUDIANT') %}

									{% if app.user.roles[0] == "ROLE_ETUDIANT" %}
										<div class="widget-heading">{{app.user.email}}</div>
										<div class="widget-subheading">
											Apprenant
										</div>
									{% endif %}

								{% endif %}

								{% if is_granted('ROLE_ADMIN') %}


									{% if app.user.roles[0] == "ROLE_ADMIN" %}
										<div class="widget-heading">{{app.user.email}}</div>
										<div class="widget-subheading">
											Administrateur
										</div>
									{% endif %}

								{% endif %}

								{% if is_granted('ROLE_INTERVENANT') %}


									{% if app.user.roles[0] == "ROLE_INTERVENANT" %}
										<div class="widget-heading">{{app.user.email}}</div>
										<div class="widget-subheading">
											Intervenant
										</div>
									{% endif %}

								{% endif %}


								{% if is_granted('ROLE_TUTEUR') %}


									{% if app.user.roles[0] == "ROLE_TUTEUR" %}
										<div class="widget-heading">{{app.user.email}}</div>
										<div class="widget-subheading">
											Tuteur
										</div>
									{% endif %}

								{% endif %}


							</div>
							<div class="widget-content-right header-user-info ml-3">
								<a href="">
									<button type="button" class="btn-shadow p-1 btn btn-primary btn-sm show-toastr-example">
										<i class="fa text-white fa-calendar pr-1 pl-1"></i>
									</button>
								</a>
							</div>
						</div>
					</div>
				</div>

			</div>
		</div>
	</div>
{% endblock %}
