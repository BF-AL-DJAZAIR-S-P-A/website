{% block MenuLeft %}

	{% set route_name = app.request.attributes.get('_route') %}
	<div class="app-sidebar sidebar-shadow">
		<div class="app-header__logo">
			<div class="logo-src"><img src="{{asset('img/logo4.svg')}}"></div>
			<div class="header__pane ml-auto">
				<div>
					<button type="button" class="hamburger close-sidebar-btn hamburger--elastic" data-class="closed-sidebar">
						<span class="hamburger-box">
							<span class="hamburger-inner"></span>
						</span>
					</button>
				</div>
			</div>
		</div>
		<div class="app-header__mobile-menu">
			<div>
				<button type="button" class="hamburger hamburger--elastic mobile-toggle-nav">
					<span class="hamburger-box">
						<span class="hamburger-inner"></span>
					</span>
				</button>
			</div>
		</div>
		<div class="app-header__menu">
			<span>
				<button type="button" class="btn-icon btn-icon-only btn btn-primary btn-sm mobile-toggle-header-nav">
					<span class="btn-icon-wrapper">
						<i class="fa fa-ellipsis-v fa-w-6"></i>
					</span>
				</button>
			</span>
		</div>
		<div class="scrollbar-sidebar">
			<div class="app-sidebar__inner">
				<ul class="vertical-nav-menu">
					<li class="app-sidebar__heading"></li>
				

						<li {% if route_name in  ['app_appels_index','app_appels_new','app_appels_edit','app_candidatures_index','app_candidatures_edit','app_acctualites_index','app_acctualites_new','app_acctualites_edit'] %} class="mm-active" {% endif %}>
								<a href="#">
									<i class="metismenu-icon pe-7s-config"></i>
									Administration
									<i class="metismenu-state-icon pe-7s-angle-down caret-left"></i>
								</a>
								<ul>

									<li><a href="{{path('app_candidatures_index')}}" {% if route_name in  ['app_candidatures_index','app_candidatures_edit'] %} class="mm-active" {% endif %}><i class="metismenu-icon pe-7s-display2"></i> {{ 'menuAdmin.candidats'|trans }} <i class="metismenu-state-icon "></i></a></li>

									
									<li><a href="{{path('app_appels_index')}}" {% if route_name in  ['app_appels_index','app_appels_new','app_appels_edit'] %} class="mm-active" {% endif %}><i class="metismenu-icon pe-7s-display2"></i> {{ 'menuAdmin.appels'|trans }}<i class="metismenu-state-icon "></i></a></li>

									<li><a href="{{path('app_acctualites_index')}}" {% if route_name in  ['app_acctualites_index','app_acctualites_new','app_acctualites_edit'] %} class="mm-active" {% endif %}><i class="metismenu-icon pe-7s-display2"></i> {{ 'menuAdmin.actualites'|trans }} <i class="metismenu-state-icon "></i></a></li>

									

					
								</ul>
							</li>
				

				</div>
			</div>
		</div>


	{% endblock %}
