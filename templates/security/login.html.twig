{% extends 'base.html.twig' %}

{% block title %}Log in!{% endblock %}

{% block body %}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

<style>
form {
  max-width: 420px;
  width: 90%;
  margin: 6vh auto;
  padding: 28px;
  background: #ffffff;
  border-radius: 12px;
  box-shadow: 0 6px 24px rgba(14, 21, 47, 0.08);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial;
  color: #222;
  box-sizing: border-box;
}
form h1.h3 {
  font-size: 20px;
  margin-bottom: 18px;
  font-weight: 600;
  color: #111827;
}
form label {
  display: block;
  font-size: 13px;
  margin: 10px 0 6px;
  color: #374151;
}
.form-control {
  display: block;
  width: 100%;
  padding: 10px 40px 10px 12px; /* padding right augmenté pour l’icône */
  font-size: 15px;
  line-height: 1.2;
  color: #111;
  background: #f8fafc;
  border: 1px solid #d1d5db;
  border-radius: 8px;
  transition: border-color .15s ease, box-shadow .15s ease;
  box-sizing: border-box;
}
.form-control:focus {
  outline: none;
  border-color: #3b82f6;
  box-shadow: 0 0 0 4px rgba(59,130,246,0.08);
  background: #fff;
}
.btn {
  display: inline-block;
  width: 100%;
  padding: 11px 14px;
  font-size: 15px;
  font-weight: 600;
  text-align: center;
  border-radius: 10px;
  border: none;
  cursor: pointer;
  background: linear-gradient(180deg,#2563eb,#1d4ed8);
  color: #fff;
  box-shadow: 0 6px 18px rgba(37,99,235,0.18);
  transition: transform .08s ease, box-shadow .12s ease, opacity .12s ease;
}
.btn:hover { transform: translateY(-1px); }
.btn:active { transform: translateY(0); box-shadow: 0 4px 12px rgba(16,24,40,0.08); }
.alert.alert-danger {
  background: #fff1f0;
  border: 1px solid #fecaca;
  color: #7f1d1d;
  padding: 10px 12px;
  border-radius: 8px;
  margin-bottom: 12px;
  font-size: 13px;
}
form .mb-3 { margin-bottom: 1rem; }
form .mb-3 a { color: #2563eb; text-decoration: none; }
form .mb-3 a:hover { text-decoration: underline; }

/* --- Password wrapper --- */
.password-wrapper {
  position: relative;
  display: flex;
  align-items: center;
}
.toggle-password {
  position: absolute;
  right: 12px;
  cursor: pointer;
  font-size: 18px;
  color: #6b7280;
  user-select: none;
  transition: color 0.2s ease;
}
.toggle-password:hover { color: #111827; }

@media (max-width: 480px) {
  form { padding: 20px; margin: 4vh 12px; border-radius: 10px; }
  .btn { padding: 10px; font-size: 15px; }
}
body{
        background: #e9ecef;
}
</style>

<form method="post">
    {% if error %}
        <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
    {% endif %}

    {% if app.user %}
        <div class="mb-3">
            You are logged in as {{ app.user.userIdentifier }}, <a href="{{ path('app_logout') }}">Logout</a>
        </div>
    {% endif %}

    <h1 class="h3 mb-3 font-weight-normal">Please sign in</h1>

    <label for="inputEmail">Email</label>
    <input type="email" value="{{ last_username }}" name="email" id="inputEmail" class="form-control" autocomplete="email" required autofocus>

    <label for="inputPassword">Password</label>
    <div class="password-wrapper">
        <input type="password" name="password" id="inputPassword" class="form-control" autocomplete="current-password" required>
        <span class="toggle-password" id="togglePassword"><i class="bi bi-eye"></i></span>
    </div>

    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}"><br><br>

    <button class="btn btn-lg btn-primary" type="submit">Sign in</button>
</form>

<script>
  const pwdInput = document.getElementById("inputPassword");
  const toggleBtn = document.getElementById("togglePassword");
  const icon = toggleBtn.querySelector("i");

  toggleBtn.addEventListener("click", () => {
    const isPassword = pwdInput.type === "password";
    pwdInput.type = isPassword ? "text" : "password";
    icon.classList.toggle("bi-eye");
    icon.classList.toggle("bi-eye-slash");
  });
</script>
{% endblock %}
